Subject: [PATCH 2/3] =?UTF-8?q?feat(peft):=20diagscale=20adapter=20?=
 =?UTF-8?q?=E2=80=94=20per-(head,dim)=20query=20multiplier=201+delta?=
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

Port of the TabPFN-3 diagscale PEFT recipe (learned diagonal similarity
metric) to the PyTorch TabFM. inject_diagscale registers a zero-init
delta [nhead, hd] on matched MultiheadAttention modules; the forward
multiplies the FINAL query (after RoPE / q-RMSNorm / per_dim_scale,
before SDPA-at-scale-1.0) by 1+delta, so q̃·k = qᵀ diag(1+δ) k exactly
and injection is behavior-preserving at init. select_trainable(mode=
full|regex|diagscale) picks the optimizer's params, mirroring the
tabpfn fork's finetuning/peft.py.
---
 tabfm/src/pytorch/model.py     |  10 +++
 tabfm/src/pytorch/peft.py      | 118 +++++++++++++++++++++++++++++++
 tabfm/src/pytorch/peft_test.py | 125 +++++++++++++++++++++++++++++++++
 3 files changed, 253 insertions(+)
 create mode 100644 tabfm/src/pytorch/peft.py
 create mode 100644 tabfm/src/pytorch/peft_test.py

diff --git a/tabfm/src/pytorch/model.py b/tabfm/src/pytorch/model.py
index 0accc02..f783054 100644
--- a/tabfm/src/pytorch/model.py
+++ b/tabfm/src/pytorch/model.py
@@ -100,6 +100,11 @@ class MultiheadAttention(nn.Module):
     self.query_ln = RMSNorm(self.hd)
     self.key_ln = RMSNorm(self.hd)
     self.per_dim_scale = nn.Parameter(torch.zeros(self.hd))
+    # Optional diagscale PEFT adapter (see peft.py): a per-(head,dim) query
+    # multiplier 1+delta, zero-init at injection time so it starts as a no-op.
+    # Plain None here (not a Parameter) so checkpoints load strict=True; the
+    # parameter only exists after peft.inject_diagscale.
+    self.diag_delta = None
 
   def forward(self, query, key, value, attn_mask=None, rope=None):
     b, tq, d = query.shape
@@ -117,6 +122,11 @@ class MultiheadAttention(nn.Module):
     # per-dim scale in float32 (softplus), then cast to compute dtype -- matches JAX PerDimScale.
     scale = 1.442695041 / math.sqrt(self.hd) * F.softplus(self.per_dim_scale.float())
     q = q * scale.to(q.dtype)
+    if self.diag_delta is not None:
+      # diagscale PEFT: diagonal similarity metric on the FINAL query (after
+      # RoPE/RMSNorm/per_dim_scale, before SDPA-at-scale-1.0), so that
+      # q̃·k = qᵀ diag(1+δ) k exactly. delta: [nhead, hd] broadcast over [B,T,N,D].
+      q = q * (1.0 + self.diag_delta).to(q.dtype)
     q, k, v = (z.transpose(1, 2) for z in (q, k, v))  # [B,N,T,D]
     # bf16 SDPA (flash already does the softmax in float32 internally).
     o = F.scaled_dot_product_attention(q, k, v, attn_mask=attn_mask, scale=1.0)
diff --git a/tabfm/src/pytorch/peft.py b/tabfm/src/pytorch/peft.py
